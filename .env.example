# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (which is git-ignored).
# 2. Fill in the appropriate local paths and configuration variables.
# 3. NEVER commit secrets, credentials, or actual API keys to version control.
# ==============================================================================

# Data Directories
DATA_DIR=dataset
INTERMEDIATE_DIR=intermediate
OUTPUT_DIR=output

# Execution Settings
DEVICE=cpu
NUM_WORKERS=8
RANDOM_SEED=42

# Optional Cloud Integration Placeholders (Safe Templates - Do Not Commit Real Keys)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_API_KEY=
DATABASE_URL=
